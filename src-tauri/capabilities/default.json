{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/attachments/**" }]
    },
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "process:default"
  ]
}
